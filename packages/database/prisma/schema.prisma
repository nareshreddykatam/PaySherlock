// PaySherlock database schema — Phase 1 foundation.
//
// Scope: normalized internal representations of Razorpay payment data,
// sufficient for the future AI agent to query. This is deliberately NOT a
// 1:1 copy of Razorpay's API/webhook shapes — see docs/decisions for the
// normalization and money-representation rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A merchant account connected to PaySherlock. Single-tenant for the MVP,
/// but modeled as a first-class entity so multi-merchant support doesn't
/// require a schema rewrite later.
model Merchant {
  id                 String   @id @default(cuid())
  name               String
  /// Razorpay's `account_id`, as seen on webhook payloads. Nullable because
  /// it's only known once the first webhook/API call from that account
  /// arrives.
  razorpayAccountId  String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders          Order[]
  payments        Payment[]
  refunds         Refund[]
  settlements     Settlement[]
  issues          Issue[]
  recommendations Recommendation[]
  actions         Action[]
  auditEvents     AuditEvent[]

  @@map("merchants")
}

enum OrderStatus {
  CREATED
  ATTEMPTED
  PAID
}

/// Normalized Razorpay Order.
model Order {
  id               String      @id @default(cuid())
  merchant         Merchant    @relation(fields: [merchantId], references: [id])
  merchantId       String
  /// Razorpay's `order_xxx` id — the external source of truth.
  razorpayOrderId  String      @unique
  /// Integer minor units (paise for INR) — never a float. See ADR on money.
  amount           Int
  amountPaid       Int         @default(0)
  amountDue        Int         @default(0)
  currency         String      @default("INR")
  status           OrderStatus @default(CREATED)
  receipt          String?
  attempts         Int         @default(0)
  notes            Json?
  /// Full source payload as last observed, preserved for audit/investigation.
  raw              Json
  razorpayCreatedAt DateTime
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  payments Payment[]

  @@index([merchantId, status])
  @@map("orders")
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CARD
  NETBANKING
  WALLET
  UPI
  EMI
  OTHER
}

/// Normalized Razorpay Payment — the central entity future investigations
/// query and reason about.
model Payment {
  id                  String        @id @default(cuid())
  merchant            Merchant      @relation(fields: [merchantId], references: [id])
  merchantId          String
  /// Razorpay's `pay_xxx` id — the external source of truth.
  razorpayPaymentId   String        @unique
  order               Order?        @relation(fields: [orderId], references: [id])
  orderId             String?
  /// Kept even when `orderId` is null so we can backfill the relation once
  /// the order is ingested (payment webhooks can arrive before order data).
  razorpayOrderId     String?
  amount              Int
  amountRefunded      Int           @default(0)
  currency            String        @default("INR")
  status              PaymentStatus
  method              PaymentMethod
  captured            Boolean       @default(false)
  international       Boolean       @default(false)
  email               String?
  contact             String?
  errorCode           String?
  errorDescription    String?
  notes               Json?
  raw                 Json
  razorpayCreatedAt   DateTime
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  refunds         Refund[]
  paymentEvents   PaymentEvent[]
  recommendations Recommendation[]

  @@index([merchantId, status])
  @@index([merchantId, razorpayCreatedAt])
  @@index([method])
  @@map("payments")
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

/// Normalized Razorpay Refund.
model Refund {
  id                 String       @id @default(cuid())
  merchant           Merchant     @relation(fields: [merchantId], references: [id])
  merchantId         String
  /// Razorpay's `rfnd_xxx` id — the external source of truth.
  razorpayRefundId   String       @unique
  payment            Payment      @relation(fields: [paymentId], references: [id])
  paymentId          String
  /// Kept for direct lookups/debugging without a join.
  razorpayPaymentId  String
  amount             Int
  currency           String       @default("INR")
  status             RefundStatus
  speedProcessed     String?
  speedRequested     String?
  notes              Json?
  raw                Json
  razorpayCreatedAt  DateTime
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([paymentId])
  @@map("refunds")
}

enum PaymentEventProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Normalized, deduplicated log of inbound Razorpay webhook events. This is
/// both the idempotency ledger (unique on `externalEventId`) and the audit
/// trail for investigating webhook processing after the fact.
model PaymentEvent {
  id                 String                        @id @default(cuid())
  /// Razorpay's `x-razorpay-event-id` header value — unique per delivery,
  /// the basis for idempotent processing. See docs/decisions for rationale.
  externalEventId    String                        @unique
  /// e.g. "payment.captured", "order.paid", "refund.processed".
  eventType          String
  provider           String                        @default("razorpay")
  /// e.g. "payment", "order", "refund".
  resourceType       String
  /// The Razorpay id of the affected resource, e.g. "pay_xxx".
  resourceId         String
  occurredAt         DateTime
  /// The full normalized webhook payload, preserved for audit/investigation.
  payload            Json
  processingStatus   PaymentEventProcessingStatus @default(RECEIVED)
  errorMessage       String?
  payment            Payment?                      @relation(fields: [paymentId], references: [id])
  paymentId          String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@index([eventType])
  @@index([resourceType, resourceId])
  @@map("payment_events")
}

enum IssueAnomalyType {
  PAYMENT_FAILURE_SPIKE
  PAYMENT_METHOD_DEGRADATION
  REFUND_SPIKE
  TRANSACTION_VOLUME_DECLINE
  HIGH_VALUE_TRANSACTION_DECLINE
}

enum IssueSeverityLevel {
  INFO
  WARNING
  CRITICAL
}

enum IssueLifecycleStatus {
  DETECTED
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
  DISMISSED
  INVESTIGATION_FAILED
}

/// Phase 4 — a persisted anomaly the deterministic detection engine found,
/// optionally enriched by the existing Phase 2 investigation engine. See
/// docs/decisions for the fingerprint/dedup strategy and lifecycle rules.
model Issue {
  id         String   @id @default(cuid())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  merchantId String

  type     IssueAnomalyType
  /// Human-readable, e.g. "UPI payment degradation" — never re-derived by
  /// the frontend.
  title    String
  severity IssueSeverityLevel
  status   IssueLifecycleStatus @default(DETECTED)

  detectedAt DateTime

  metric         String
  currentValue   Float
  baselineValue  Float
  absoluteChange Float
  relativeChange Float?
  sampleSize     Int
  /// e.g. a payment method name for PAYMENT_METHOD_DEGRADATION; null for
  /// merchant-wide detectors.
  dimension      String?

  /// Deterministic dedup key (type + dimension + day bucket) — see
  /// docs/decisions. Uniqueness among *active* issues is enforced in
  /// application code (packages/database/src/upsert/issue.ts), not a DB
  /// constraint, so a resolved/dismissed issue's fingerprint can recur as a
  /// brand-new row later without being blocked by history.
  fingerprint     String
  /// How many consecutive detection runs have confirmed this same active
  /// issue — the basis for the persistence-based severity escalation
  /// policy (see docs/decisions).
  occurrenceCount Int    @default(1)

  /// Set once an automatic investigation has been triggered — never
  /// re-triggered for the same issue while it's already set and the issue
  /// is active (storm prevention).
  investigationId String?
  rootCause       String?
  /// Mirrors InvestigationResult.confidence ("low" | "medium" | "high") —
  /// stored as a plain string rather than a second small enum, matching
  /// how similar optional derived text fields (e.g. Payment.errorCode) are
  /// modeled elsewhere in this schema.
  confidence      String?
  estimatedImpactMinorUnits Int?
  /// Full cached InvestigationResult (evidence, hypotheses, recommendations,
  /// …) from the triggering investigation, so the issue-detail view can
  /// render it without a separate investigation-persistence layer.
  investigationResult Json?
  /// Safe (no stack trace) message when status is INVESTIGATION_FAILED.
  investigationError   String?

  recommendations Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId, status])
  @@index([merchantId, fingerprint])
  @@map("issues")
}

// --- Phase 5: Guarded Recommendations & Actions -----------------------------
// See docs/decisions/0005-guarded-actions.md. Hard rule behind every field
// below: the LLM never executes a financial action — it only ever supplies
// explanatory text (`Recommendation.explanation`); type, riskLevel, amount,
// and every state transition are computed/enforced by deterministic code.

enum RecommendationType {
  /// The only real financial action in Phase 5 — refund a specific payment
  /// by a specific integer-minor-units amount, never "all payments" or an
  /// unbounded amount.
  REFUND_PAYMENT
  /// PaySherlock investigated and is explicitly recommending *no* action —
  /// a first-class, non-financial outcome, not a fallback.
  NO_ACTION
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RecommendationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTING
  SUCCEEDED
  FAILED
  EXPIRED
}

/// Execution-mechanical subset of the lifecycle — an Action row only ever
/// exists once a recommendation has been approved (see docs/decisions for
/// why this is a separate, narrower enum rather than reusing
/// RecommendationStatus for both).
enum ActionStatus {
  APPROVED
  EXECUTING
  SUCCEEDED
  FAILED
}

/// A PaySherlock-generated suggestion — never itself a command. Every
/// financial recommendation (REFUND_PAYMENT) requires explicit merchant
/// approval before packages/actions ever constructs a Razorpay request; a
/// NO_ACTION recommendation never becomes an Action at all.
model Recommendation {
  id         String   @id @default(cuid())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  merchantId String

  /// Set only for a recommendation tied to a Phase 4 automatic
  /// investigation; the automatic detection→investigation path does not
  /// currently generate recommendations itself (none of Phase 4's five
  /// merchant-wide detectors identify a single actionable payment — see
  /// docs/decisions) but the schema supports the link for a
  /// merchant-initiated investigation that happens to reference an issue.
  issue           Issue?  @relation(fields: [issueId], references: [id])
  issueId         String?
  /// The Phase 2 InvestigationResult.meta.investigationId this
  /// recommendation was generated from — informational only; the full
  /// result itself is not duplicated here (ask the investigation/issue
  /// record for that), matching the "don't duplicate" guidance.
  investigationId String?

  type        RecommendationType
  title       String
  /// LLM-influenced explanatory prose — never parsed or trusted for a
  /// decision; display-only.
  explanation String

  /// Deterministic policy output (packages/actions/src/policy) — never an
  /// LLM judgment.
  riskLevel RiskLevel
  status    RecommendationStatus @default(PENDING_APPROVAL)

  /// Our internal Payment.id (never a client-supplied Razorpay id at
  /// creation time) — the specific payment this recommendation concerns.
  /// Null for NO_ACTION.
  payment          Payment? @relation(fields: [targetPaymentId], references: [id])
  targetPaymentId  String?
  amountMinorUnits Int?
  currency         String?

  action Action?

  approvedAt DateTime?
  rejectedAt DateTime?
  /// Optional bounded validity window (Phase 5 brief section 28) — an
  /// expired PENDING_APPROVAL recommendation can never transition to
  /// APPROVED; a fresh investigation must generate a new one.
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId, status])
  @@map("recommendations")
}

/// The execution attempt for an approved recommendation — created exactly
/// once, at approval time, and never again for that recommendation (a
/// retry reuses this same row and its `idempotencyKey`, see
/// docs/decisions). One-to-one with Recommendation by design: this is
/// "how the approved action is being/was carried out", not a duplicate of
/// "what was recommended and why" (that stays on Recommendation).
model Action {
  id               String         @id @default(cuid())
  merchant         Merchant       @relation(fields: [merchantId], references: [id])
  merchantId       String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id])
  recommendationId String         @unique

  type   RecommendationType
  status ActionStatus       @default(APPROVED)

  paymentId        String?
  amountMinorUnits Int?
  currency         String?

  /// Deterministic, derived from the *recommendation's* own id
  /// (`paysherlock-refund-<recommendationId>`) — never a fresh random value
  /// per attempt, so a retry with the same key can never create two
  /// refunds. Unique-constrained as a second, database-level guarantee
  /// alongside the application-level reuse.
  idempotencyKey String @unique

  /// Razorpay's own id for the created resource, e.g. `rfnd_xxx`.
  providerReference String?
  /// Razorpay's own status string at last check (e.g. "processed") — kept
  /// separate from `status` so raw provider state is always inspectable.
  providerStatus    String?

  /// Safe (no stack trace, no request/response body, no credentials) error
  /// metadata only — see docs/decisions on what audit/error fields may
  /// never contain.
  errorCode    String?
  errorMessage String?

  createdAt   DateTime  @default(now())
  approvedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([merchantId, status])
  @@map("actions")
}

enum AuditEventType {
  RECOMMENDATION_CREATED
  RECOMMENDATION_APPROVED
  RECOMMENDATION_REJECTED
  ACTION_STARTED
  ACTION_SUCCEEDED
  ACTION_FAILED
}

/// Append-only audit trail. Rows are never updated or deleted by
/// application code — a changed situation always means a *new* event, not
/// an edited old one (Phase 5 brief section 23).
model AuditEvent {
  id         String   @id @default(cuid())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  merchantId String

  eventType        AuditEventType
  recommendationId String?
  actionId         String?

  /// Small, safe, structured metadata only — e.g. `{"riskLevel":"MEDIUM"}`
  /// or `{"errorCode":"BAD_REQUEST_ERROR"}`. Never secrets, credentials,
  /// authorization headers, or raw provider request/response bodies.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([recommendationId])
  @@map("audit_events")
}

/// Normalized Razorpay Settlement. Schema only in Phase 1 — no
/// ingestion/webhook wiring yet (see docs/decisions for scope rationale).
model Settlement {
  id                     String   @id @default(cuid())
  merchant               Merchant @relation(fields: [merchantId], references: [id])
  merchantId             String
  /// Razorpay's `setl_xxx` id — the external source of truth.
  razorpaySettlementId   String   @unique
  amount                 Int
  status                 String
  utr                    String?
  raw                    Json
  settledAt              DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("settlements")
}

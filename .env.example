# ---------------------------------------------------------------------------
# PaySherlock — Environment Variables (example)
# Copy to .env and fill in real values locally. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
DATABASE_URL=

# --- Redis / Background jobs -------------------------------------------------
REDIS_URL=

# --- Razorpay -----------------------------------------------------------------
# Server-side only. Never expose these to the frontend/browser bundle.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI Provider (provider-independent adapter) ------------------------------
# AI_PROVIDER selects which adapter implementation to use (e.g. "openai", "anthropic").
AI_PROVIDER=
AI_API_KEY=

# --- App ----------------------------------------------------------------------
NODE_ENV=development

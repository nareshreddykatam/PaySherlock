# ---------------------------------------------------------------------------
# PaySherlock — Environment Variables (example)
# Copy to .env and fill in real values locally. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
DATABASE_URL=


# --- Razorpay -----------------------------------------------------------------
# Test Mode keys only (Dashboard → Account & Settings → API Keys → Test Mode).
# Never use Live Mode credentials in development.
# Server-side only — read by apps/api and packages/razorpay. Never expose
# these to the frontend/browser bundle.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when configuring the webhook in the Razorpay Dashboard (Test Mode URL).
# Used to verify the X-Razorpay-Signature header — see docs/decisions.
RAZORPAY_WEBHOOK_SECRET=

# --- AI Provider (provider-independent adapter) ------------------------------
# AI_PROVIDER selects the LLM adapter: "deterministic" (default — no
# credentials needed, used by tests/eval) or "anthropic" (real model; also
# requires AI_MODEL and AI_API_KEY). Leave all three blank to run with the
# deterministic provider.
AI_PROVIDER=deterministic
AI_MODEL=
AI_API_KEY=
# Hard cap on tool-call steps per investigation (bounded agent loop).
MAX_AGENT_STEPS=8

# --- Detection worker (workers/investigator) ---------------------------------
# How often `pnpm --filter @paysherlock/investigator-worker run start`
# re-runs detection, in milliseconds. Default: 15 minutes. Not used by the
# one-shot `run detect` command.
DETECTION_INTERVAL_MS=900000

# --- App ----------------------------------------------------------------------
NODE_ENV=development
# apps/api HTTP port.
PORT=4000

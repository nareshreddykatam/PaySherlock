# PaySherlock web — copy to .env.local and adjust for your environment.
# Next.js loads .env* files from this directory automatically.

# Base URL of the PaySherlock API (apps/api). Must be reachable from the
# browser — this is a public, client-visible value (NEXT_PUBLIC_ prefix),
# never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:4000

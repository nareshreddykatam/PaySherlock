{
  "name": "@paysherlock/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "ingest": "tsx src/scripts/ingest.ts",
    "eval:phase4": "tsx src/eval/cli.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@paysherlock/agent": "workspace:*",
    "@paysherlock/database": "workspace:*",
    "@paysherlock/detection": "workspace:*",
    "@paysherlock/razorpay": "workspace:*",
    "@paysherlock/tools": "workspace:*",
    "@paysherlock/types": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "fastify": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

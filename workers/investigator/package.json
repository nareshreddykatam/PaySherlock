{
  "name": "@paysherlock/investigator-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts --watch",
    "detect": "tsx src/index.ts",
    "start": "node dist/index.js --watch",
    "demo:seed": "tsx src/demo/seed.ts",
    "demo:reset": "tsx src/demo/reset.ts",
    "demo:run": "tsx src/demo/run.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@paysherlock/agent": "workspace:*",
    "@paysherlock/database": "workspace:*",
    "@paysherlock/detection": "workspace:*",
    "@paysherlock/tools": "workspace:*",
    "@paysherlock/types": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
